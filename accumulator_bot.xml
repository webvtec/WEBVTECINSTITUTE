<xml xmlns="http://www.w3.org/1999/xhtml" collection="false">
  <block type="trade_definition" id="accumulator_setup" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="market_v100">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">R_100</field>
        <next>
          <block type="trade_definition_tradetype" id="type_accum">
            <field name="TRADETYPE_LIST">accumulator</field>
            <next>
              <block type="trade_definition_contracttype" id="contract_accum">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="candle_1m">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuyloss" id="restart_loss">
                        <field name="RESTARTBUYLOSS">true</field>
                        <next>
                          <block type="trade_definition_restartbuywin" id="restart_win">
                            <field name="RESTARTBUYWIN">true</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="init_stake">
        <field name="VAR">stake</field>
        <value name="VALUE">
          <block type="math_number">
            <field name="NUM">1</field>
          </block>
        </value>
      </block>
    </statement>
    <statement name="SUBSTRUCTURE">
      <block type="trade_definition_accumulator" id="growth_3pct">
        <field name="GROWTH_RATE">0.03</field>
        <value name="AMOUNT">
          <block type="variables_get">
            <field name="VAR">stake</field>
          </block>
        </value>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="buy_logic" x="0" y="450">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="purchase" id="execute_buy">
        <field name="PURCHASE_LIST">ACCUM</field>
      </block>
    </statement>
  </block>
  <block type="during_purchase" id="sell_logic" x="0" y="550">
    <statement name="DURING_PURCHASE_STACK">
      <block type="controls_if" id="auto_sell">
        <value name="IF0">
          <block type="logic_compare">
            <field name="OP">GTE</field>
            <value name="A">
              <block type="tick_count"></block>
            </value>
            <value name="B">
              <block type="math_number">
                <field name="NUM">5</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="sell_at_market" id="exit_trade"></block>
        </statement>
      </block>
    </statement>
  </block>
</xml>
