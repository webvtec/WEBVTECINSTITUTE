<xml xmlns="http://www.w3.org/1999/xhtml" collection="false">
  <block type="trade_definition" id="acc_trade" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="m_v100">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">R_100</field>
        <next>
          <block type="trade_definition_tradetype" id="t_acc">
            <field name="TRADETYPE_LIST">accumulator</field>
            <next>
              <block type="trade_definition_contracttype" id="c_acc">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="ci_1m">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuyloss" id="res_l">
                        <field name="RESTARTBUYLOSS">true</field>
                        <next>
                          <block type="trade_definition_restartbuywin" id="res_w">
                            <field name="RESTARTBUYWIN">true</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBSTRUCTURE">
      <block type="trade_definition_accumulator" id="acc_logic">
        <field name="GROWTH_RATE">0.03</field>
        <value name="AMOUNT">
          <block type="math_number">
            <field name="NUM">1000</field>
          </block>
        </value>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="buy_logic" x="0" y="480">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="purchase" id="buy_acc">
        <field name="PURCHASE_LIST">ACCUM</field>
      </block>
    </statement>
  </block>
  <block type="during_purchase" id="sell_logic" x="0" y="580">
    <statement name="DURING_PURCHASE_STACK">
      <block type="controls_if" id="tp_check">
        <value name="IF0">
          <block type="logic_compare">
            <field name="OP">GTE</field>
            <value name="A">
              <block type="sell_price"></block>
            </value>
            <value name="B">
              <block type="math_number">
                <field name="NUM">1150</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="sell_at_market" id="exit"></block>
        </statement>
      </block>
    </statement>
  </block>
</xml>
